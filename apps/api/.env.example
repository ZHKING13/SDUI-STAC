DATABASE_URL=postgresql://famille:famille@localhost:5432/famille
PORT=3001
# Origine autorisée à appeler l'API depuis un navigateur (le site Next.js)
WEB_ORIGIN=http://localhost:3000
# Adresse du site, utilisée dans les liens envoyés par e-mail (par défaut : la première de WEB_ORIGIN)
WEB_URL=http://localhost:3000
# Envoi réel des e-mails, ex. relais SMTP de l'offre gratuite Brevo :
# SMTP_URL=smtp://identifiant:cle@smtp-relay.brevo.com:587
# Sans SMTP_URL, les e-mails (et leurs liens) sont écrits dans le journal de l'API.
MAIL_FROM=Famille Wodie <no-reply@famille-wodie.local>

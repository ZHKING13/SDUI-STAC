{
  "name": "@famille/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx --env-file-if-exists=.env prisma/create-admin.ts"
  },
  "dependencies": {
    "@famille/shared": "workspace:*",
    "@fastify/helmet": "13.2.0",
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-fastify": "11.2.10",
    "@nestjs/throttler": "6.8.0",
    "@prisma/client": "6.19.3",
    "fastify": "5.12.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76",
    "argon2": "0.44.0",
    "nodemailer": "7.0.13"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.10",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "ts-jest": "29.4.15",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "@types/nodemailer": "7.0.12"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "(test|src)/.*\\.(spec|e2e-spec)\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}

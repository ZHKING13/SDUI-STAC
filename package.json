{
  "name": "famille-wodie",
  "private": true,
  "description": "Site de la famille Wodie : vitrine publique et espace famille",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter ./packages/* build && pnpm -r --filter ./apps/* build",
    "test": "pnpm -r --filter ./packages/* build && pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "pnpm --filter @famille/api dev",
    "dev:web": "pnpm --filter @famille/web dev",
    "db:migrate": "pnpm --filter @famille/api prisma:migrate",
    "db:seed": "pnpm --filter @famille/api prisma:seed"
  }
}
